# Copy this file to .env and fill in real values. .env is gitignored.
# Both of these come from Supabase Dashboard -> Project Settings -> API.
# The anon key is safe to expose in a client app by design.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# The backend's public URL - the ngrok tunnel from `ngrok http 3000`, not
# localhost (the phone and the dev machine are usually on different
# networks). Must match the backend's own BACKEND_URL, and the tunnel host
# must match the authorized redirect URI on the Google OAuth client for
# Gmail linking. App.js reads this for every backend call; leaving it unset
# silently prefixes "undefined" onto every request URL rather than failing
# with a useful error.
EXPO_PUBLIC_API_URL=
