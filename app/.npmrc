# expo-router pulls in vaul (a web-only drawer/dialog component) which
# transitively requires react-dom@^19.2.8 via @radix-ui/react-* - this
# project pins react@19.1.0 to match react-native 0.81.5, and that peer
# conflict makes a strict install (npm ci, which is what EAS Build's
# "Install dependencies" phase uses) fail hard, even though a plain local
# `npm install` tolerates it with just a warning. legacy-peer-deps is the
# standard fix for this exact class of conflict in React Native projects -
# committed here so local installs and EAS's clean-room build stay
# consistent, rather than only working by accident on one machine.
legacy-peer-deps=true
