# secrets - never commit these
.env
.env.local
*.env
# Catches accidental backup/save copies too (e.g. server/.env.save, found
# untracked and containing real secrets 2026-08-21 - *.env alone doesn't
# match a .save suffix appended after .env).
.env.*
!.env.example

