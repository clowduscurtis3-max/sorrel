# Copy this file to .env and fill in real values. .env is gitignored.

# Plaid Dashboard -> Developers -> Keys
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Supabase Project Settings -> API Keys -> service_role (secret) key.
# NEVER put this in the mobile app - it bypasses all database access rules.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=

# 32-byte key (base64), used to encrypt Plaid/Gmail tokens at rest before
# they're stored in Supabase. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing this key makes every stored token unrecoverable (you'd need to
# unlink and re-link bank/Gmail accounts) - back it up somewhere safe,
# separate from this .env file.
ENCRYPTION_KEY=

# Google Cloud Console -> APIs & Services -> Credentials -> your OAuth client.
# Used for the optional Gmail receipt-scanning link, separate from Google
# Sign-In. Requires the Gmail API enabled and this backend's callback URL
# added as an authorized redirect URI on the same OAuth client.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Publicly reachable URL for this backend (e.g. the ngrok tunnel URL while
# developing). Must match what's registered as the Google OAuth redirect URI.
BACKEND_URL=

# Comma-separated list of email addresses allowed to use this app. Checked
# against the verified email on each Supabase session token - anyone else
# who signs in with Google gets a 403. Required: if unset, every request is
# rejected (fails closed), not silently open to any Google account.
ALLOWED_EMAILS=

PORT=3000
